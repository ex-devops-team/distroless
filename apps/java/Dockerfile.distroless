# syntax=docker/dockerfile:1
FROM maven:3.9.9-eclipse-temurin-21 AS quality
WORKDIR /src
COPY pom.xml .
COPY src ./src
RUN mvn -B -q spotless:apply spotless:check test
RUN touch /quality.ok

FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
COPY --from=quality /quality.ok /quality.ok
RUN mvn -B -q -DskipTests package

FROM gcr.io/distroless/java21-debian12:nonroot
WORKDIR /app
COPY --from=build /src/target/health-0.0.1-SNAPSHOT.jar /app/app.jar
EXPOSE 8080
CMD ["app.jar"]
