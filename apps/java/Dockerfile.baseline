# syntax=docker/dockerfile:1
FROM maven:3.9.9-eclipse-temurin-21 AS quality
WORKDIR /src
COPY pom.xml .
COPY src ./src
RUN mvn -B -q spotless:apply spotless:check test
RUN touch /quality.ok

FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
COPY --from=quality /quality.ok /quality.ok
RUN mvn -B -q -DskipTests package

# Temurin 21 JRE в build-stage; финальный OS-слой — Debian 12 bookworm.
FROM eclipse-temurin:21-jre AS temurin-jre

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"
COPY --from=temurin-jre ${JAVA_HOME} ${JAVA_HOME}
WORKDIR /app
COPY --from=build /src/target/health-0.0.1-SNAPSHOT.jar /app/app.jar
USER nobody
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
