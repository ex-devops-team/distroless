# syntax=docker/dockerfile:1
# Debian 12 + Python 3.11 — та же major/minor, что gcr.io/distroless/python3-debian12.
FROM python:3.11-slim-bookworm AS quality
WORKDIR /app
COPY pyproject.toml ruff.toml ./
RUN pip install --no-cache-dir ".[dev]"
COPY main.py test_main.py ./
RUN ruff check .
RUN pytest -q
RUN touch /quality.ok

FROM python:3.11-slim-bookworm AS runtime
WORKDIR /app
COPY pyproject.toml ./
RUN pip install --no-cache-dir .
COPY main.py ./
COPY --from=quality /quality.ok /quality.ok
USER nobody
EXPOSE 8080
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
