# syntax=docker/dockerfile:1
FROM golang:1.22-bookworm AS quality
WORKDIR /src
RUN curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh \
  | sh -s -- -b /usr/local/bin v1.61.0
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN golangci-lint run ./...
RUN go test ./...
RUN touch /quality.ok

FROM golang:1.22-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=quality /quality.ok /quality.ok
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/health .

FROM debian:bookworm-slim
RUN useradd --uid 65532 --create-home --shell /usr/sbin/nologin nonroot
USER nonroot
COPY --from=build /out/health /health
EXPOSE 8080
ENTRYPOINT ["/health"]
