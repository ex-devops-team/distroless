# syntax=docker/dockerfile:1
FROM maven:3.9.9-eclipse-temurin-21 AS quality
WORKDIR /src
COPY pom.xml .
COPY src ./src
RUN mvn -B -q spotless:apply spotless:check test
RUN touch /quality.ok

FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
COPY --from=quality /quality.ok /quality.ok
RUN mvn -B -q -DskipTests package

FROM eclipse-temurin:21-jdk AS jre
COPY jlink-jre.sh /jlink-jre.sh
COPY --from=build /src/target/health2-0.0.1-SNAPSHOT.jar /app.jar
RUN chmod +x /jlink-jre.sh && /jlink-jre.sh /app.jar /jre

FROM build AS extract
WORKDIR /extract
RUN java -Djarmode=layertools -jar /src/target/health2-0.0.1-SNAPSHOT.jar extract

FROM gcr.io/distroless/cc-debian12:nonroot
ENV JAVA_HOME=/jre
WORKDIR /app
COPY --from=jre --chown=65532:65532 /jre /jre
COPY --from=extract --chown=65532:65532 /extract/dependencies/ ./
COPY --from=extract --chown=65532:65532 /extract/spring-boot-loader/ ./
COPY --from=extract --chown=65532:65532 /extract/snapshot-dependencies/ ./
COPY --from=extract --chown=65532:65532 /extract/application/ ./
EXPOSE 8080
ENTRYPOINT ["/jre/bin/java", "org.springframework.boot.loader.launch.JarLauncher"]
