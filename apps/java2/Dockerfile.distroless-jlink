# syntax=docker/dockerfile:1
FROM maven:3.9.9-eclipse-temurin-21 AS quality
WORKDIR /src
COPY pom.xml .
COPY src ./src
RUN mvn -B -q spotless:apply spotless:check test
RUN touch /quality.ok

FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
COPY --from=quality /quality.ok /quality.ok
RUN mvn -B -q -DskipTests package

FROM eclipse-temurin:21-jdk AS jre
COPY jlink-jre.sh /jlink-jre.sh
COPY --from=build /src/target/health2-0.0.1-SNAPSHOT.jar /app.jar
RUN chmod +x /jlink-jre.sh && /jlink-jre.sh /app.jar /jre

FROM gcr.io/distroless/cc-debian12:nonroot
ENV JAVA_HOME=/jre
WORKDIR /app
COPY --from=jre --chown=65532:65532 /jre /jre
COPY --from=build --chown=65532:65532 /src/target/health2-0.0.1-SNAPSHOT.jar /app/app.jar
EXPOSE 8080
ENTRYPOINT ["/jre/bin/java", "-jar", "/app/app.jar"]
