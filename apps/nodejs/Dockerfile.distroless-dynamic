# syntax=docker/dockerfile:1
FROM node:22.22.0-bookworm AS quality
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY server.js server.test.js eslint.config.js ./
RUN npm run lint
RUN npm test
RUN touch /quality.ok

FROM node:22.22.0-bookworm AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server.js ./
COPY --from=quality /quality.ok /quality.ok

FROM gcr.io/distroless/nodejs22-debian12:nonroot
WORKDIR /app
COPY --from=build /app /app
EXPOSE 8080
CMD ["server.js"]
