# syntax=docker/dockerfile:1
# Pin 22.22.x — та же minor, что gcr.io/distroless/nodejs22-debian12 на момент выравнивания.
FROM node:22.22.0-bookworm AS quality
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY server.js server.test.js eslint.config.js ./
RUN npm run lint
RUN npm test
RUN touch /quality.ok

FROM node:22.22.0-bookworm-slim AS runtime
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server.js ./
COPY --from=quality /quality.ok /quality.ok
USER node
EXPOSE 8080
CMD ["node", "server.js"]
